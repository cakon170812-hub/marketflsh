name: Publicar DOMINO FLASH COIN Android OTA Z31

on:
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: dfc-android-ota
  cancel-in-progress: false

jobs:
  publicar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: true
      - name: Validar archivos Z31 y paquete anterior
        shell: bash
        run: |
          set -euo pipefail
          test -s index.html
          test -s android-approved/bundles/0.12Z.30.zip
          grep -q 'dfc-z31-admin-gifts-controller' index.html
          unzip -t android-approved/bundles/0.12Z.30.zip >/dev/null
      - name: Construir paquete OTA sin perder recursos nativos Z30
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/dfc_bundle"
          unzip -q android-approved/bundles/0.12Z.30.zip -d "$RUNNER_TEMP/dfc_bundle"
          test -f "$RUNNER_TEMP/dfc_bundle/index.html" || {
            echo "ERROR: la estructura del ZIP Z30 no tiene index.html en la raíz"; exit 1;
          }
          cp index.html "$RUNNER_TEMP/dfc_bundle/index.html"
          test -s "$RUNNER_TEMP/dfc_bundle/index.html"
          mkdir -p android-approved/bundles
          (
            cd "$RUNNER_TEMP/dfc_bundle"
            zip -qr "$GITHUB_WORKSPACE/android-approved/bundles/0.12Z.31.zip" .
          )
          unzip -t android-approved/bundles/0.12Z.31.zip >/dev/null
          unzip -p android-approved/bundles/0.12Z.31.zip index.html | grep -q 'dfc-z31-admin-gifts-controller'
      - name: Publicar manifiesto con el SHA256 real del ZIP
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import json,hashlib,datetime,pathlib
          root=pathlib.Path('android-approved')
          bundle=root/'bundles/0.12Z.31.zip'
          sha=hashlib.sha256(bundle.read_bytes()).hexdigest()
          manifest={
            "version":"0.12Z.31",
            "url":"https://cakon170812-hub.github.io/marketflsh/android-approved/bundles/0.12Z.31.zip",
            "sha256":sha,
            "type":"capacitor-web-bundle",
            "created_at":datetime.datetime.now(datetime.timezone.utc).isoformat()
          }
          (root/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
          print('Z31 SHA256:',sha)
          PY
      - name: Guardar publicación en GitHub
        shell: bash
        run: |
          set -euo pipefail
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add android-approved/manifest.json android-approved/bundles/0.12Z.31.zip
          if git diff --cached --quiet; then echo "Z31 ya publicada"; exit 0; fi
          git commit -m "Publicar actualización Android OTA 0.12Z.31"
          git push
